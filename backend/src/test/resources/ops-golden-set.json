     "decision": {"action": "tool", "tool": "task.create", "params": {"projectName": "三一重能", "taskName": "冒烟测试", "priority": "高"}},
     "expect": {"pending": "task.create", "contains": ["所属项目名称：三一重能一期", "- 任务名称：冒烟测试", "确认"]}},

    {"id": "task-create-assignee-ambiguous", "module": "任务管理", "utterance": "帮我创建任务：项目三一重能一期，任务名联调，负责人张三",
     "fixtures": {"projects": [{"id": 1, "code": "PRJ001", "name": "三一重能一期"}],
       "users": [{"id": 11, "username": "zhangsan", "realName": "张三"}, {"id": 12, "username": "zhangsanf", "realName": "张三丰"}]},
     "decision": {"action": "tool", "tool": "task.create", "params": {"projectName": "三一重能一期", "taskName": "联调", "assignee": "张三"}},
     "expect": {"contains": ["匹配到多位", "zhangsan(张三)", "zhangsanf(张三丰)"]}},

