{
  "name": "hermes-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Hermes Studio - Hermes Agent 全功能 Web 控制台（自研，参考 Ekko Studio 架构思路）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.mjs",
    "start:dev": "node server/index.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.7.0",
    "express": "^4.19.2",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.8"
  }
}
