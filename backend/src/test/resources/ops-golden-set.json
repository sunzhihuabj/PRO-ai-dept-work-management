{
  "说明": "AI 系统操作 golden set 回归基线（P0-2）。每个用例：utterance + 网关判定输出（decision/decisionRaw/decisionRetry/gatewayThrows），在纯 Mockito 环境下走 tryOps 全链路（声明式校验→语义校验→权限→执行/待确认），断言回复文案/待确认状态/是否转通用对话（isNull）/prompt 注入内容（渐进披露与记忆）。",
  "字段约定": {
    "decision": "网关首轮返回的判定 JSON（对象，序列化后作为 chat 应答）",
    "decisionRaw": "网关返回的原始杂文（含围栏/噪音，验证 parseDecision 鲁棒性）",
    "decisionRetry": "写入意图被误判强制重判定时的第二轮返回",
    "stubs": "执行器桩：kb.search.empty / cost.ledger.empty / perm.grant / contract.detail.missing / task.detail.missing",
    "fixtures": "projects[{id,code,name}] / users[{id,username,realName}] 实体匹配桩数据",
    "expect": "isNull=转通用对话；pending=应进入待确认的工具名；pendingNone=待确认应已清空；contains/notContains=回复文案断言；promptContains/promptNotContains=decide prompt 注入断言",
    "followup": "第二轮对话（确认/取消/澄清），可带 decision 与独立 expect"
  },
  "cases": [
    {"id": "task-myTodo-empty", "module": "任务管理", "utterance": "查一下我的待办任务",
     "decision": {"action": "tool", "tool": "task.myTodo", "params": {}},
     "expect": {"pendingNone": true, "contains": ["当前没有符合条件的记录。"]}},

    {"id": "task-list-empty", "module": "任务管理", "utterance": "查一下进行中的任务",
     "decision": {"action": "tool", "tool": "task.list", "params": {"status": "进行中"}},
     "expect": {"pendingNone": true, "contains": ["未查询到符合条件的记录。"]}},

    {"id": "task-list-bad-enum", "module": "任务管理", "utterance": "查一下进行状态的任务",
     "decision": {"action": "tool", "tool": "task.list", "params": {"status": "进行"}},
     "expect": {"contains": ["参数有误", "任务状态」仅支持"]}},

    {"id": "task-create-missing", "module": "任务管理", "utterance": "帮我创建一个任务",
     "decision": {"action": "tool", "tool": "task.create", "params": {}},
     "expect": {"contains": ["还需要补充", "所属项目名称"]}},

    {"id": "task-create-pending-norm", "module": "任务管理", "utterance": "帮我创建任务：项目三一重能，任务名冒烟测试，优先级高",
